# ─── Structify backend ───
# Copy this file to .env and fill in the values.

# Google Gemini API key (required in production)
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Secret used to sign login tokens. REQUIRED in production (>= 32 chars).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Application settings
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database. Leave empty for local SQLite (backend/data/structify.db).
# In production use Postgres, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# File upload limits
MAX_UPLOAD_SIZE_MB=10

# CORS origins (comma-separated). In production set this to your frontend URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: create a bootstrap account at startup (both must be set).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional abuse controls
# AUTH_RATE_LIMIT_PER_MINUTE=10
# PIPELINE_RUNS_PER_HOUR=10
# MAX_ACTIVE_JOBS_PER_USER=2
